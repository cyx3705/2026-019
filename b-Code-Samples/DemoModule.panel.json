{
  "id": "demopanel",
  "title": "Demo 演示面板",
  "visible": true,
  "side": "right",
  "ratio": 0.22,
  "controls": [
    { "type": "label",  "id": "hint", "label": "说明", "default": "MD-08:随模块 DLL 一起投放的面板" },
    { "type": "number", "id": "a",    "label": "加数 a", "min": -1000000, "max": 1000000, "default": "1" },
    { "type": "number", "id": "b",    "label": "加数 b", "min": -1000000, "max": 1000000, "default": "2" },
    { "type": "button", "label": "相加 (DemoModule.Add)", "command": "DemoModule.Add a={a} b={b}" },
    { "type": "text",   "id": "text", "label": "文本", "default": "OneHistory" },
    { "type": "button", "label": "反转 (DemoModule.Reverse)", "command": "DemoModule.Reverse text=\"{text}\"" }
  ]
}
