<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="HistoryDianaVersion.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HistoryDiana</AssemblyName>
    <RootNamespace>HistoryDiana</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <!-- AI 工作树落在库根之外时相对路径必然指空；diana.worktree.create 生成的
         Directory.Build.user.props 会设定 HistoryVulcanPackageRoot，这里据此推导。 -->
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == '' and '$(HISTORYVULCAN_PACKAGE_ROOT)' != ''">$(HISTORYVULCAN_PACKAGE_ROOT)</HistoryVulcanPackageRoot>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostDir Condition="'$(HistoryVulcanHostDir)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostDir>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HistoryDiana.Smoke" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostDir)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      项目库根与发布包定位随开发路线迁入宿主（HistoryVulcan 4.6.0）并提为公开面。
      Diana 的 z 文档通道与项目对齐指令消费它们，不再各留一份——
      「z-Publish 还是别的名字」这类约定分叉起来极难发现。
    -->
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanHostDir)\HistoryVulcan.Services.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
