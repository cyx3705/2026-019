<Project>
  <PropertyGroup>
    <HistoryDianaVersion>2.7.0</HistoryDianaVersion>
    <!-- Vulcan 5.0 收窄 IModuleContext；Diana 通过自身运行时解析器读取项目根和 MCP 端点。 -->
    <MinimumHistoryVulcanVersion>6.0.0</MinimumHistoryVulcanVersion>
    <VersionPrefix>$(HistoryDianaVersion)</VersionPrefix>
    <Version>$(HistoryDianaVersion)</Version>
    <AssemblyVersion>$(HistoryDianaVersion).0</AssemblyVersion>
    <FileVersion>$(HistoryDianaVersion).0</FileVersion>
    <InformationalVersion>$(HistoryDianaVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
