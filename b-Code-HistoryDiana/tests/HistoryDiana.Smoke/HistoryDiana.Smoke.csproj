<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == '' and '$(HISTORYVULCAN_PACKAGE_ROOT)' != ''">$(HISTORYVULCAN_PACKAGE_ROOT)</HistoryVulcanPackageRoot>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\HistoryDiana.csproj" />
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanPackageRoot)\host\HistoryVulcan.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
