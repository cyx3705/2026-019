      ".ignore",
      "project.manifest.json",
      "b-Code/README.md",
      "b-Code/Test-ProjectContract.ps1",
      "b-Code/Build-HistoryDianaPackage.ps1"
    ],
    "linkCheckExclusions": [
      "*\\history\\*",
      "*-References\\*"
    ]
  },
  "commands": {
    "setup": "dotnet restore .\\b-Code-HistoryDiana\\HistoryDiana.csproj",
    "build": "dotnet build .\\b-Code-HistoryDiana\\HistoryDiana.csproj -c Release",
    "test": "dotnet run --project .\\b-Code-HistoryDiana\\tests\\HistoryDiana.Smoke\\HistoryDiana.Smoke.csproj -c Release",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code\\Test-ProjectContract.ps1 -Instantiation",
    "run": null,
    "package": "HistoryVulcan.Cli.exe --cli vulcan.dev.submit name=HistoryDiana worktree=<工作区>"
  },
  "externalDependencies": [
    {
      "name": ".NET SDK",
      "version": "9.0.315",
      "purpose": "构建 net8.0-windows 目标"
    },
    {
      "name": "HistoryVulcan",
      "version": "6.0.0",
      "purpose": "Diana 的模块 API、命令总线与正式运行宿主"
    }
  ],
  "contextExclusions": [
    "z-Publish/**",
    "b-References/**",
    "**/bin/**",
    "**/obj/**",
    "**/.vs/**"
  ],
  "publish": {
    "versionProps": "b-Code-HistoryDiana\\HistoryDianaVersion.props",
    "versionProperty": "HistoryDianaVersion",
    "sourceManifest": "b-Code-HistoryDiana\\module.manifest.json",
    "package": {
      "project": "b-Code-HistoryDiana\\HistoryDiana.csproj",
      "files": [
        "HistoryDiana.dll",
        "HistoryDiana.xml",
        "module.manifest.json"
      ]
    },
    "validation": [
      {
        "tool": "dotnet.exe",
        "arguments": [
          "run",
          "--project",
          "b-Code-HistoryDiana\\tests\\HistoryDiana.Smoke\\HistoryDiana.Smoke.csproj",
          "-c",
          "Release",
          "-p:NuGetAudit=false"
        ],
        "description": "Run module Smoke"
      }
    ]
  }
}
